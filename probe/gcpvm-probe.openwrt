#!/bin/sh /etc/rc.common
# OpenWrt / iStoreOS 开机自启脚本（主动上报模式）
# 安装：
#   cp gcpvm-probe.openwrt /etc/init.d/gcpvm-probe && chmod +x /etc/init.d/gcpvm-probe
#   修改下面的 PANEL 与 TOKEN
#   /etc/init.d/gcpvm-probe enable && /etc/init.d/gcpvm-probe start
# 查看日志：logread -e gcpvm

START=99
USE_PROCD=1

PANEL="http://面板地址:8080"
TOKEN="面板里生成的令牌"
SCRIPT="/root/gcpvm-probe/probe.py"

start_service() {
	procd_open_instance gcpvm-probe
	procd_set_param command /usr/bin/python3 "$SCRIPT"
	procd_set_param env PROBE_PANEL="$PANEL" PROBE_TOKEN="$TOKEN"
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
